# PatchPilot Backend Environment Configuration
PORT=3001
NODE_ENV=development

# Optional: GitHub personal access token, used ONLY server-side for higher
# GitHub API rate limits. Never sent to the frontend. Public repos work
# without it (60 req/hour unauthenticated vs 5000 with a token).
# GITHUB_TOKEN=ghp_your_token_here

# Frontend Proxy Target (Optional Override)
VITE_API_URL=http://localhost:3001
